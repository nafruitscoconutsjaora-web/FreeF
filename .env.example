# ============================================================
# FF PANEL STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your PHP + MySQL production server
# ============================================================

APP_NAME="FF Panel Store"
APP_ENV="production"
APP_KEY="base64_random_generated_key_32_chars"
APP_URL="https://yourstore.com"

# DATABASE (MySQL 8.0+ / MariaDB 10.5+)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="ff_panel_store"
DB_USERNAME="ff_store_user"
DB_PASSWORD="your_secure_mysql_password"

# RAZORPAY PAYMENT GATEWAY (Server-Side Only - Never expose key secret to frontend)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret"

# STORE DEFAULTS & CURRENCY
STORE_CURRENCY="INR"
STORE_CURRENCY_SYMBOL="₹"
USD_INR_EXCHANGE_RATE="85.50"
DEFAULT_MARKUP_PERCENT="15.00"

# AI STUDIO RUNTIME INJECTION
GEMINI_API_KEY=""
